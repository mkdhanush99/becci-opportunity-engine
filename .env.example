BECCI_ENV=development
BECCI_DATABASE_URL=sqlite:///./data/becci.db
BECCI_SECRET_KEY=becci-production-super-secret-key-32chars-min
BECCI_CORS_ORIGINS=["http://localhost:3000","https://becci.in","https://preview.becci.in"]
BECCI_PUBLIC_RATE_LIMIT_PER_MINUTE=120
BECCI_ADMIN_RATE_LIMIT_PER_MINUTE=300
BECCI_BROWSER_MAX_CONCURRENCY=2
BECCI_BROWSER_NAVIGATION_TIMEOUT_MS=45000
BECCI_ENFORCE_DOMAIN_ALLOWLIST=true

# Autonomous Scraping & AI Engine
APIFY_API_TOKEN=your_apify_api_token_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_DEFAULT_MODEL=deepseek-flash
DEEPSEEK_ADVANCED_MODEL=deepseek-v4-pro
BECCI_AUTO_SCHEDULER_ENABLED=true
