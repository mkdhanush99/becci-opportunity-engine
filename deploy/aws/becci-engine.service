[Unit]
Description=BECCI Opportunity Intelligence Engine (FastAPI v3.0.0)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/becci-opportunity-engine
EnvironmentFile=/opt/becci-opportunity-engine/.env
ExecStart=/opt/becci-opportunity-engine/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
